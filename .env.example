# 복사해서 .env로 사용 (.env는 커밋 금지)

# LLM (vLLM 등 OpenAI 호환 서버). 비워두면 규칙 기반
LLM_BASE_URL=
LLM_MODEL=

# STT: text(기본, 시뮬레이션) | whisper
STT_BACKEND=text
STT_MODEL=large-v3
STT_DEVICE=cuda
STT_DENOISE=1

# TTS: text(기본) | melo
TTS_BACKEND=text
TTS_DEVICE=cuda
TTS_SPEED=1.1

# server(Spring) 통보 주소. {incident_id} 치환
SERVER_CALLBACK_URL=http://localhost:8080/api/incidents/{incident_id}/calls

# 발신 허용 번호 접두사 (쉼표 구분). 팀원 폰 번호만 추가할 것
ALLOWED_PHONES=sim:
